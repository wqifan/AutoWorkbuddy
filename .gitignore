# 本地临时产物
.venv/
.build-venv/
__pycache__/
*.pyc

# 打包中间产物与生成的 exe（体积大，且本机已能直接跑脚本）
build/
dist/
*.spec

# WorkBuddy 本地工程数据，不进仓库
.workbuddy/

# 运行期产物（脚本按环境变量写在 runner 的临时目录，正常不会出现在仓库里）
buddy-raw.json
buddy-summary.md
probe_raw.json
run_raw.json

# 绝不提交任何 token / 登录态
workbuddy-desktop*.info
token.txt
*.secret

# 打包生成的 exe（可随时用 .build-venv 重新生成）
UpdateBuddyToken.exe

# PyInstaller 工作目录（--workpath）
.build-tmp/

# Cloudflare Worker 的手动触发口令（等同于一个开放入口的钥匙，绝不进仓库）
.trigger_key

# wrangler 本地状态目录（含账号相关缓存）
.wrangler/

# 打包中间目录（另一个 --workpath）
.build-tmp2/
